---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ACQUISITION_MAILTO, BUY_MAILTO, FAQ, SITE } from '../consts';
import { getCollection } from 'astro:content';

const siteData = await getCollection('site');
const { useCases = [], whyCards = [] } = siteData[0]?.data ?? {};

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const faqJsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQ.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: {
        '@type': 'Answer',
        text: item.a,
      },
    })),
  },
];
---

<BaseLayout jsonLd={faqJsonLd}>
  <!-- Hero Section -->
  <header class="hero-bg min-h-[100dvh] flex items-center relative pt-20">
    <div class="max-w-5xl mx-auto px-6 pb-24 pt-12 md:pt-8 text-center relative z-10">
      <!-- Premium Badge + price -->
      <div class="flex flex-wrap items-center justify-center gap-3 mb-8">
        <div class="inline-flex items-center gap-x-2 px-4 py-1.5 rounded-full border border-white/10 bg-white/5">
          <div class="w-1.5 h-1.5 bg-[#22f5ff] rounded-full animate-pulse" aria-hidden="true"></div>
          <span class="text-xs font-semibold tracking-[1.5px] text-white/80">PREMIUM .COM DOMAIN &middot; FOR SALE</span>
        </div>
        <div class="inline-flex items-center gap-x-2 px-4 py-1.5 rounded-full border border-emerald-400/30 bg-emerald-400/10">
          <span class="text-xs font-bold tracking-[1.5px] text-emerald-300">{SITE.priceDisplay} USD &middot; AVAILABLE NOW</span>
        </div>
      </div>

      <!-- Domain Name -->
      <h1 class="domain-text font-display mb-3 tracking-[-0.07em]">
        ailegalguard.com
      </h1>

      <!-- Tagline -->
      <p class="max-w-2xl mx-auto text-3xl md:text-4xl font-light tracking-tight text-white/90 mb-4">
        The first name typed<br />
        when inquiring about AI legal issues.
      </p>

      <p class="max-w-lg mx-auto text-xl text-white/70 mb-10">
        Authoritative. Protective. Unmistakable.<br />
        The definitive digital address for AI law, compliance &amp; protection.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href={BUY_MAILTO}
          class="group w-full sm:w-auto tap gap-x-3 px-9 text-lg font-semibold rounded-3xl transition-all active:scale-[0.985] no-underline gradient-cta text-[#0a0a0f] hover:brightness-110 shadow-xl shadow-[#22f5ff]/20"
        >
          <span>Buy Now — {SITE.priceDisplay}</span>
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 group-hover:translate-x-0.5 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.25" d="M14 5l7 7-7 7m-4-7h11" />
          </svg>
        </a>
        <a
          href="#inquire"
          class="w-full sm:w-auto tap gap-x-2 px-8 text-lg font-medium rounded-3xl border border-white/20 hover:bg-white/5 transition-colors no-underline text-white/80"
        >
          Make an Offer
        </a>
      </div>

      <!-- Trust bar -->
      <ul class="mt-12 flex flex-wrap items-center justify-center gap-x-7 gap-y-3 text-xs text-white/55 list-none p-0">
        <li class="flex items-center gap-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 8.944 11.922a12.024 12.024 0 01-4.462-8.968" />
          </svg>
          <span>Escrow.com protected</span>
        </li>
        <li class="flex items-center gap-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#22f5ff]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          <span>Instant push transfer</span>
        </li>
        <li class="flex items-center gap-x-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#a855f7]" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
          </svg>
          <span>HTTPS secured &middot; one-of-one asset</span>
        </li>
      </ul>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-10 left-1/2 -translate-x-1/2 hidden lg:block">
      <div class="flex flex-col items-center gap-y-1 text-[10px] tracking-widest text-white/40">
        <div>SCROLL TO BEGIN</div>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 animate-bounce" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7" />
        </svg>
      </div>
    </div>
  </header>

  <!-- The Positioning Section -->
  <section id="positioning" class="max-w-5xl mx-auto px-6 pt-20 pb-16">
    <div class="grid md:grid-cols-12 gap-x-12 items-center">
      <div class="md:col-span-7 reveal">
        <div class="inline-block px-3.5 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-4">THE POSITIONING</div>

        <h2 class="section-header tracking-[-0.04em] leading-none mb-7">
          The AI Legal Guardian.
        </h2>

        <div class="space-y-6 text-lg text-white/80 max-w-[42ch]">
          <p>
            As artificial intelligence transforms every industry, a new and urgent category of legal issues has emerged — from data rights and algorithmic bias to liability, intellectual property, and regulatory compliance.
          </p>
          <p>
            <span class="font-semibold text-white">ailegalguard.com</span> is the clear, authoritative, and memorable domain that professionals will naturally type first when they need trusted guidance on AI-related legal matters.
          </p>
          <p class="text-white/70">
            It signals protection, expertise, and immediate relevance in one of the fastest-growing and most complex areas of law today.
          </p>
        </div>
      </div>

      <div class="md:col-span-5 mt-10 md:mt-0 reveal">
        <div class="glass rounded-3xl p-9 md:p-10 border border-white/10">
          <div class="text-center">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-2xl bg-gradient-to-br from-[#22f5ff]/10 to-[#a855f7]/10 border border-white/20 mb-6">
              <span class="font-display text-xl font-bold tracking-[-1px] bg-gradient-to-br from-[#22f5ff] to-[#a855f7] bg-clip-text text-transparent">AI LEGAL</span>
            </div>

            <div class="space-y-1">
              <div class="text-3xl font-bold tracking-tighter">Guard</div>
              <div class="text-sm text-white/60 tracking-[2px] mt-1">PROTECTION &middot; COMPLIANCE &middot; AUTHORITY</div>
            </div>

            <div class="mt-8 pt-6 border-t border-white/10 text-sm text-white/60 leading-relaxed">
              The definitive digital address<br />
              for AI law and legal protection.
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Why This Domain Section -->
  <section id="why" class="bg-white/5 border-y border-white/10 py-16">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-12 reveal">
        <div class="inline-block px-4 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-3">WHY THIS DOMAIN</div>
        <h2 class="section-header tracking-[-0.03em]">Built for trust in a high-stakes field.</h2>
      </div>

      <div class="grid md:grid-cols-3 gap-5">
        {
          whyCards.map((card, i) => {
            const icons = [
              `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 8.944 11.922a12.024 12.024 0 01-4.462-8.968" />`,
              `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2.009 2.009 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />`,
              `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />`,
            ];
            const colors = ['text-[#22f5ff]', 'text-[#a855f7]', 'text-emerald-400'];
            const bgColors = ['bg-[#22f5ff]/10', 'bg-[#a855f7]/10', 'bg-emerald-400/10'];
            return (
              <div class="modern-card glass reveal rounded-3xl p-8 border border-white/10">
                <div class={`w-11 h-11 rounded-2xl ${bgColors[i]} flex items-center justify-center mb-6`}>
                  <svg xmlns="http://www.w3.org/2000/svg" class={`w-6 h-6 ${colors[i]}`} fill="none" viewBox="0 0 24 24" stroke="currentColor" set:html={icons[i]} />
                </div>
                <h3 class="font-semibold text-xl tracking-tight mb-3">{card.title}</h3>
                <p class="text-white/70 leading-relaxed">{card.description}</p>
              </div>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Ideal For / Use Cases -->
  <section id="uses" class="max-w-6xl mx-auto px-6 py-20">
    <div class="max-w-2xl mb-12 reveal">
      <div class="inline-block px-3.5 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-4">IDEAL FOR</div>
      <h2 class="section-header tracking-[-0.035em] leading-none">The natural home for leaders in AI law.</h2>
    </div>

    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
      {
        useCases.map((useCase) => (
          <div class="group reveal p-7 rounded-3xl border border-white/10 hover:border-white/20 transition-colors bg-white/[0.015]">
            <div class="font-mono text-xs tracking-widest text-[#22f5ff] mb-2">
              {String(useCase.number).padStart(2, '0')}
            </div>
            <div class="font-semibold text-lg mb-2 group-hover:text-[#22f5ff] transition-colors">
              {useCase.title}
            </div>
            <p class="text-sm text-white/60">{useCase.description}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Insights strip (internal linking to long-form content) -->
  {
    posts.length > 0 && (
      <section id="insights" class="border-y border-white/10 bg-white/[0.02] py-12">
        <div class="max-w-6xl mx-auto px-6 reveal">
          <div class="flex flex-col gap-6 md:flex-row md:items-end md:justify-between">
            <div class="max-w-xl">
              <div class="inline-block px-3.5 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-4">
                DOMAIN INSIGHTS
              </div>
              <h2 class="text-2xl font-semibold tracking-tight md:text-3xl">
                Research before you wire a dollar.
              </h2>
              <p class="mt-2 text-white/60">
                Valuation method, escrow mechanics, and the red flags that separate a good
                acquisition from an expensive mistake.
              </p>
            </div>
            <div class="flex flex-col gap-2">
              {posts.map((post) => (
                <a
                  href={`/blog/${post.id}/`}
                  class="group inline-flex min-h-[48px] items-center gap-x-3 text-sm text-white/75 no-underline hover:text-[#22f5ff] transition-colors"
                >
                  <span class="font-mono text-[11px] text-white/35">{post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}</span>
                  <span class="group-hover:underline underline-offset-4">{post.data.title}</span>
                </a>
              ))}
            </div>
          </div>
          <a href="/blog/" class="mt-6 inline-flex min-h-[48px] items-center gap-x-2 text-sm font-semibold text-[#22f5ff] no-underline hover:gap-x-3 transition-all">
            All guides
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.25" d="M14 5l7 7-7 7m-4-7h11" />
            </svg>
          </a>
        </div>
      </section>
    )
  }

  <!-- Poignant Closer -->
  <div class="max-w-3xl mx-auto px-6 text-center py-14 border-b border-white/10">
    <p class="text-2xl md:text-3xl font-light tracking-tight text-white/90">
      In the age of artificial intelligence,<br />
      <span class="font-semibold text-white">protection begins with the right name.</span>
    </p>
  </div>

  <!-- FAQ -->
  <section id="faq" class="max-w-4xl mx-auto px-6 py-20">
    <div class="text-center mb-10 reveal">
      <div class="inline-block px-4 py-1 rounded-full bg-white/5 text-xs tracking-[1.5px] font-medium text-white/60 mb-4">BUYER FAQ</div>
      <h2 class="section-header tracking-[-0.03em]">Everything a serious buyer asks.</h2>
    </div>

    <div class="space-y-3">
      {
        FAQ.map((item) => (
          <details class="group reveal rounded-2xl border border-white/10 bg-white/[0.02] open:border-[#22f5ff]/30 transition-colors">
            <summary class="flex min-h-[56px] cursor-pointer list-none items-center justify-between gap-4 px-6 py-4 [&::-webkit-details-marker]:hidden">
              <h3 class="text-base font-semibold tracking-tight text-white sm:text-lg m-0">{item.q}</h3>
              <span
                class="flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-white/15 text-[#22f5ff] transition-transform duration-300 group-open:rotate-45"
                aria-hidden="true"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M12 4v16m8-8H4" />
                </svg>
              </span>
            </summary>
            <p class="px-6 pb-5 -mt-1 text-white/70 leading-relaxed">{item.a}</p>
          </details>
        ))
      }
    </div>
  </section>

  <!-- Pricing Section -->
  <section id="pricing" class="max-w-4xl mx-auto px-6 pb-20">
    <div class="text-center mb-10 reveal">
      <div class="inline-block px-4 py-1 rounded-full bg-emerald-400/10 text-emerald-400 text-xs tracking-[1.5px] font-semibold mb-4">ACQUISITION</div>
      <h2 class="section-header tracking-[-0.03em]">A strategic asset for a defining legal frontier.</h2>
    </div>

    <div class="glass reveal rounded-3xl p-8 sm:p-10 md:p-14 border border-white/10">
      <div class="flex flex-col gap-y-8 md:flex-row md:items-end md:justify-between">
        <div>
          <div class="flex items-baseline gap-x-2">
            <span class="text-5xl font-semibold tracking-tighter sm:text-7xl">{SITE.priceDisplay}</span>
            <span class="text-white/50 text-xl">USD</span>
          </div>
          <p class="mt-1 text-white/60">One-time acquisition &middot; Full ownership &amp; instant transfer</p>

          <ul class="mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm list-none p-0">
            <li class="flex items-center gap-x-2 text-white/70">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
              <span>Clean title, ready for transfer</span>
            </li>
            <li class="flex items-center gap-x-2 text-white/70">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
              <span>Escrow.com protected transaction</span>
            </li>
            <li class="flex items-center gap-x-2 text-white/70">
              <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
              </svg>
              <span>No renewals, no lease, no middlemen</span>
            </li>
          </ul>
        </div>

        <div class="md:text-right">
          <div class="flex flex-col gap-3">
            <a
              href={BUY_MAILTO}
              class="tap w-full gap-x-2 px-10 rounded-3xl bg-white font-semibold text-[#0a0a0f] text-lg active:scale-[0.985] transition-all hover:bg-white/90 no-underline"
            >
              Buy Now at {SITE.priceDisplay}
            </a>
            <a
              href="#inquire"
              class="tap w-full px-8 rounded-3xl border border-white/20 font-semibold text-white/80 transition hover:border-white/45 hover:text-white no-underline"
            >
              Make an Offer
            </a>
            <a
              href={ACQUISITION_MAILTO}
              class="tap w-full px-8 rounded-3xl text-sm font-medium text-white/55 hover:text-white transition-colors no-underline"
            >
              Contact the seller directly
            </a>
          </div>
          <p class="text-xs text-white/50 mt-4 md:mt-3">Serious buyers only. Flexible terms available.</p>
        </div>
      </div>
    </div>

    <div class="mt-8 text-center">
      <p class="text-xs text-white/50 max-w-md mx-auto">
        Descriptive, brandable .com domains in high-growth specialized fields like AI law command strong long-term value. This asset offers both immediate professional utility and strategic positioning.
      </p>
    </div>
  </section>

  <!-- Inquiry / Contact Section -->
  <section id="inquire" class="bg-white/5 border-t border-white/10 py-16">
    <div class="max-w-2xl mx-auto px-6">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-semibold tracking-tight sm:text-4xl">Ready to own the AI Legal Guard?</h2>
        <p class="mt-3 text-white/70">Submit your inquiry. We respond personally to serious buyers within 24 hours.</p>
      </div>

      <!-- Form -->
      <form id="inquiry-form" class="glass rounded-3xl p-6 sm:p-8 md:p-10 border border-white/10 space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="name" class="block text-xs tracking-widest font-medium text-white/60 mb-1.5">FULL NAME</label>
            <input type="text" id="name" name="name" required autocomplete="name"
                   class="form-input w-full bg-white/5 border border-white/15 rounded-2xl px-5 min-h-[52px] text-white placeholder:text-white/40" />
          </div>
          <div>
            <label for="email" class="block text-xs tracking-widest font-medium text-white/60 mb-1.5">EMAIL ADDRESS</label>
            <input type="email" id="email" name="email" required autocomplete="email"
                   class="form-input w-full bg-white/5 border border-white/15 rounded-2xl px-5 min-h-[52px] text-white placeholder:text-white/40" />
          </div>
        </div>

        <div>
          <label for="org" class="block text-xs tracking-widest font-medium text-white/60 mb-1.5">ORGANIZATION OR INTENDED USE (OPTIONAL)</label>
          <input type="text" id="org" name="organization" autocomplete="organization"
                 class="form-input w-full bg-white/5 border border-white/15 rounded-2xl px-5 min-h-[52px] text-white placeholder:text-white/40" />
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
          <div>
            <label for="offer" class="block text-xs tracking-widest font-medium text-white/60 mb-1.5">YOUR OFFER (OPTIONAL)</label>
            <div class="relative">
              <span class="absolute left-5 top-1/2 -translate-y-1/2 text-white/40" aria-hidden="true">$</span>
              <input type="text" id="offer" name="offer" inputmode="numeric" placeholder="100000"
                     class="form-input w-full bg-white/5 border border-white/15 rounded-2xl pl-8 pr-5 min-h-[52px] text-white placeholder:text-white/40" />
            </div>
          </div>
          <div>
            <label for="timeline" class="block text-xs tracking-widest font-medium text-white/60 mb-1.5">TIMELINE</label>
            <select id="timeline" name="timeline" class="form-input w-full bg-white/5 border border-white/15 rounded-2xl px-5 min-h-[52px] text-white appearance-none">
              <option value="" class="bg-[#1a1a2e]">Select preferred timeline</option>
              <option value="immediate" class="bg-[#1a1a2e]">Immediate (within 7 days)</option>
              <option value="2weeks" class="bg-[#1a1a2e]">Within 2 weeks</option>
              <option value="month" class="bg-[#1a1a2e]">Within 30 days</option>
              <option value="flexible" class="bg-[#1a1a2e]">Flexible / exploring</option>
            </select>
          </div>
        </div>

        <div>
          <label for="message" class="block text-xs tracking-widest font-medium text-white/60 mb-1.5">MESSAGE OR QUESTIONS</label>
          <textarea id="message" name="message" rows="4" placeholder="What is your vision for ailegalguard.com?"
                    class="form-input w-full bg-white/5 border border-white/15 rounded-3xl px-5 py-4 text-white placeholder:text-white/40 resize-y min-h-[120px]"></textarea>
        </div>

        <!-- Honeypot: invisible to humans, catches naive bots -->
        <div class="hidden" aria-hidden="true">
          <label for="website">Leave this field empty</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>

        <button type="submit" id="inquiry-submit"
                class="tap w-full rounded-3xl gradient-cta font-semibold text-[#0a0a0f] text-lg tracking-[-0.2px] active:scale-[0.985] transition-all hover:brightness-105 border-0 cursor-pointer">
          Submit Secure Inquiry
        </button>

        <p id="form-status" role="status" aria-live="polite" class="hidden text-center text-sm text-rose-300"></p>

        <p class="text-center text-[11px] text-white/50 tracking-wide">
          Your information is kept confidential and never sold.
          <a href="/privacy/" class="underline underline-offset-2 hover:text-white/75">Privacy policy</a>.
          Transactions protected via escrow.
        </p>
      </form>

      <!-- Success Message (hidden by default) -->
      <div id="success-message" class="hidden mt-6 glass rounded-3xl p-8 border border-emerald-400/30 text-center">
        <div class="mx-auto w-14 h-14 rounded-full bg-emerald-400/10 flex items-center justify-center mb-5">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-7 h-7 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <h3 class="text-2xl font-semibold tracking-tight mb-2">Inquiry Received</h3>
        <p class="text-white/70 max-w-xs mx-auto">Thank you. A member of our team will personally respond within 24 hours to discuss next steps.</p>
        <div class="mt-6 flex flex-col items-center gap-3">
          <a href={BUY_MAILTO} class="tap px-7 rounded-2xl bg-white font-semibold text-[#0a0a0f] no-underline">
            Or buy now at {SITE.priceDisplay}
          </a>
          <button type="button" id="reset-inquiry"
                  class="text-sm font-medium text-white/60 hover:text-white bg-transparent border-0 underline underline-offset-4 cursor-pointer min-h-[48px]">Submit another inquiry</button>
        </div>
      </div>

      <p class="mt-6 text-center text-sm text-white/50">
        Prefer email?
        <a href={ACQUISITION_MAILTO} class="text-[#22f5ff] underline underline-offset-2"> {SITE.acquisitionEmail}</a>
      </p>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.getElementById('inquiry-form') as HTMLFormElement;
  const successMsg = document.getElementById('success-message');
  const status = document.getElementById('form-status');
  const submitBtn = document.getElementById('inquiry-submit') as HTMLButtonElement;
  const DEFAULT_LABEL = 'Submit Secure Inquiry';

  const setError = (message: string) => {
    if (!status) return;
    status.textContent = message;
    status.classList.remove('hidden');
  };

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    status?.classList.add('hidden');

    const data = new FormData(form);
    const payload = {
      type: 'inquiry',
      name: String(data.get('name') ?? '').trim(),
      email: String(data.get('email') ?? '').trim(),
      organization: String(data.get('organization') ?? ''),
      offer: String(data.get('offer') ?? ''),
      timeline: String(data.get('timeline') ?? ''),
      message: String(data.get('message') ?? ''),
      website: String(data.get('website') ?? ''),
      elapsed: Math.round(performance.now()),
      path: location.pathname,
    };

    if (!payload.email || !payload.name) {
      setError('Please add your name and a valid email address.');
      return;
    }

    const original = submitBtn.innerHTML;
    submitBtn.innerHTML = 'Sending…';
    submitBtn.disabled = true;

    try {
      const response = await fetch('/api/inquiry', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });

      if (!response.ok && response.status !== 201) {
        if (response.status === 429) throw new Error('rate_limited');
        throw new Error('request_failed');
      }

      form.style.display = 'none';
      successMsg?.classList.remove('hidden');
      successMsg?.classList.add('block');
      successMsg?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    } catch (error) {
      const rateLimited = (error as Error).message === 'rate_limited';
      setError(
        rateLimited
          ? 'Too many attempts from this device. Please email sales@desertrich.com directly.'
          : 'We could not send your inquiry. Please email sales@desertrich.com — the direct address always works.',
      );
      submitBtn.disabled = false;
      submitBtn.innerHTML = original;
    }
  });

  document.getElementById('reset-inquiry')?.addEventListener('click', () => {
    successMsg?.classList.add('hidden');
    successMsg?.classList.remove('block');
    if (form) {
      form.style.display = 'block';
      form.reset();
    }
    if (submitBtn) {
      submitBtn.disabled = false;
      submitBtn.innerHTML = DEFAULT_LABEL;
    }
    status?.classList.add('hidden');
  });
</script>
