---
import { BUY_MAILTO, SITE } from '../consts';
---

<div
  id="exit-intent"
  class="fixed inset-0 z-[90] hidden items-center justify-center p-4 sm:p-6"
  role="dialog"
  aria-modal="true"
  aria-labelledby="exit-intent-title"
  aria-describedby="exit-intent-desc"
>
  <div id="exit-backdrop" class="absolute inset-0 bg-black/75 backdrop-blur-sm"></div>

  <div class="relative w-full max-w-lg overflow-hidden rounded-[1.75rem] border border-white/12 bg-[#0d0d14] p-7 sm:p-9 shadow-2xl shadow-black/60">
    <button
      id="exit-close"
      type="button"
      class="absolute right-3 top-3 tap w-12 h-12 rounded-full text-white/50 hover:text-white hover:bg-white/5 transition-colors cursor-pointer border-0 bg-transparent"
      aria-label="Close"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mx-auto" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6h12v12" />
      </svg>
    </button>

    <p class="mb-2 text-xs font-bold uppercase tracking-[2px] text-[#22f5ff]">Free buyer's resource</p>
    <h2 id="exit-intent-title" class="pr-10 text-2xl font-semibold tracking-tight sm:text-3xl">
      The Premium Domain Buyer's Checklist
    </h2>
    <p id="exit-intent-desc" class="mt-3 text-white/65">
      Seven due-diligence checks before you wire money for any domain — escrow, transfer locks,
      UDRP history, and the red flags that cost buyers their deposit.
    </p>

    <form id="exit-form" class="mt-6 space-y-4">
      <div>
        <label for="exit-email" class="block text-xs tracking-widest font-medium text-white/60 mb-1.5">
          EMAIL ADDRESS
        </label>
        <input
          type="email"
          id="exit-email"
          name="email"
          required
          autocomplete="email"
          placeholder="you@company.com"
          class="form-input w-full bg-white/5 border border-white/15 rounded-2xl px-5 min-h-[52px] text-white placeholder:text-white/40"
        />
      </div>

      <!-- Honeypot: hidden from humans and screen readers -->
      <div class="hidden" aria-hidden="true">
        <label for="exit-website">Website</label>
        <input type="text" id="exit-website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div class="flex flex-col gap-3 sm:flex-row">
        <button
          type="submit"
          class="tap w-full gap-x-2 px-7 rounded-2xl gradient-cta font-semibold text-[#0a0a0f] active:scale-[0.985] transition-all hover:brightness-105 border-0 cursor-pointer"
        >
          Send me the checklist
        </button>
        <a
          href="/blog/how-to-buy-a-domain-name-safely/"
          class="tap w-full px-6 rounded-2xl border border-white/20 text-sm font-semibold text-white/80 hover:border-white/40 transition-colors no-underline"
        >
          Read it now
        </a>
      </div>

      <p class="text-center text-[10px] text-white/45">
        One email, one guide. No list sharing. See our <a href="/privacy/" class="underline underline-offset-2 hover:text-white/70">privacy policy</a>.
      </p>
    </form>

    <div id="exit-success" class="mt-6 hidden rounded-2xl border border-emerald-400/30 bg-emerald-400/5 p-5 text-center">
      <p class="font-semibold text-emerald-300">On its way — here's the direct link, too.</p>
      <a
        href="/blog/how-to-buy-a-domain-name-safely/"
        class="mt-3 inline-flex tap px-6 rounded-2xl bg-white font-semibold text-[#0a0a0f] no-underline"
      >
        Open the checklist
      </a>
    </div>

    <p id="exit-error" class="mt-4 hidden text-center text-sm text-rose-300">
      Something went wrong. Email
      <a href={`mailto:${SITE.acquisitionEmail}`} class="underline"> {SITE.acquisitionEmail}</a>
      and we'll send it manually.
    </p>

    <p class="mt-5 border-t border-white/10 pt-4 text-center text-xs text-white/50">
      Prefer to talk price first?
      <a href={BUY_MAILTO} class="text-[#22f5ff] underline underline-offset-2"> Buy at {SITE.priceDisplay} →</a>
    </p>
  </div>
</div>

<script>
  const modal = document.getElementById('exit-intent');
  const backdrop = document.getElementById('exit-backdrop');
  const closeBtn = document.getElementById('exit-close');
  const form = document.getElementById('exit-form') as HTMLFormElement | null;
  const success = document.getElementById('exit-success');
  const error = document.getElementById('exit-error');
  const emailInput = document.getElementById('exit-email') as HTMLInputElement | null;

  const STORAGE_KEY = 'alg-exit-shown';
  let openedAt = 0;
  let lastFocused: Element | null = null;

  const canShow = () => {
    if (sessionStorage.getItem(STORAGE_KEY)) return false;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return false;
    if (matchMedia('(hover: none)').matches) return false; // desktop only — avoids intrusive mobile interstitial
    return true;
  };

  const open = () => {
    if (!modal || modal.classList.contains('flex')) return;
    sessionStorage.setItem(STORAGE_KEY, '1');
    openedAt = Date.now();
    lastFocused = document.activeElement;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
    setTimeout(() => emailInput?.focus(), 60);
  };

  const close = () => {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = '';
    if (lastFocused instanceof HTMLElement) lastFocused.focus();
  };

  closeBtn?.addEventListener('click', close);
  backdrop?.addEventListener('click', close);
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) close();
  });

  document.addEventListener('mouseout', (e) => {
    if (!canShow()) return;
    const related = e.relatedTarget as Node | null;
    if (e.clientY <= 0 && !related) open();
  });

  // Fallback: fire once the visitor has read most of the page.
  let fallbackFired = false;
  window.addEventListener(
    'scroll',
    () => {
      if (fallbackFired || !canShow()) return;
      const depth =
        (window.scrollY + window.innerHeight) / Math.max(document.body.scrollHeight, 1);
      if (depth > 0.85) {
        fallbackFired = true;
        open();
      }
    },
    { passive: true },
  );

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    error?.classList.add('hidden');
    const button = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    const original = button.innerHTML;
    button.disabled = true;
    button.innerHTML = 'Sending…';

    try {
      const response = await fetch('/api/inquiry', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify({
          type: 'newsletter',
          email: emailInput?.value ?? '',
          elapsed: Date.now() - openedAt,
          website: (document.getElementById('exit-website') as HTMLInputElement | null)?.value ?? '',
          path: location.pathname,
          message: 'Requested the premium domain buyer checklist.',
        }),
      });
      if (!response.ok && response.status !== 201) throw new Error(String(response.status));
      form.classList.add('hidden');
      success?.classList.remove('hidden');
    } catch {
      error?.classList.remove('hidden');
      button.disabled = false;
      button.innerHTML = original;
    }
  });
</script>
