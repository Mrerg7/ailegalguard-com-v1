---
import { ACQUISITION_MAILTO } from '../consts';

const links = [
  { href: '/#positioning', label: 'The Positioning' },
  { href: '/#why', label: 'Why This Domain' },
  { href: '/#faq', label: 'FAQ' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/blog/', label: 'Insights' },
];
---

<nav id="nav" aria-label="Primary" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 border-b border-white/5">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-x-3 no-underline min-h-[48px]" aria-label="ailegalguard.com home">
        <div class="w-9 h-9 rounded-2xl bg-gradient-to-br from-[#22f5ff] via-[#a855f7] to-[#22f5ff] p-px" aria-hidden="true">
          <div class="w-full h-full bg-[#0a0a0f] rounded-2xl flex items-center justify-center">
            <span class="text-[#22f5ff] text-lg font-bold tracking-tighter">AI</span>
          </div>
        </div>
        <div>
          <span class="font-display text-2xl font-semibold tracking-tighter text-white">ailegalguard.com</span>
        </div>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden lg:flex items-center gap-x-7 text-sm font-medium">
        {
          links.map((link) => (
            <a href={link.href} class="nav-link tap text-white/80 no-underline">
              {link.label}
            </a>
          ))
        }
      </div>

      <!-- CTA Buttons -->
      <div class="flex items-center gap-x-3">
        <a
          href="/#inquire"
          class="hidden sm:inline-flex tap px-6 text-sm font-semibold rounded-2xl border border-white/20 hover:bg-white/5 transition-colors no-underline text-white/80"
        >
          Make an Offer
        </a>
        <a
          href={ACQUISITION_MAILTO}
          class="tap px-6 text-sm font-semibold rounded-2xl bg-white text-[#0a0a0f] hover:bg-white/90 transition-all active:scale-[0.985] no-underline"
        >
          Buy Now
        </a>

        <!-- Mobile Menu Button -->
        <button
          type="button"
          id="mobile-menu-btn"
          class="lg:hidden tap w-12 h-12 text-white/70 hover:text-white bg-transparent border-0 cursor-pointer"
          aria-label="Toggle menu"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg
            id="menu-icon"
            xmlns="http://www.w3.org/2000/svg"
            class="w-6 h-6 mx-auto"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </div>
  </div>
</nav>

<!-- Mobile Menu -->
<div
  id="mobile-menu"
  class="hidden lg:hidden fixed inset-0 z-40 bg-[#0a0a0f] pt-20 overflow-y-auto"
  role="dialog"
  aria-modal="true"
  aria-label="Site menu"
>
  <div class="px-6 py-8 flex flex-col gap-y-2 text-lg font-medium">
    {
      links.map((link) => (
        <a href={link.href} class="py-3.5 min-h-[48px] flex items-center text-white/80 no-underline border-b border-white/5">
          {link.label}
        </a>
      ))
    }
    <div class="pt-5">
      <a
        href={ACQUISITION_MAILTO}
        class="tap w-full py-4 rounded-2xl bg-white text-[#0a0a0f] font-semibold no-underline"
      >
        Buy This Domain
      </a>
    </div>
  </div>
</div>

<script>
  const nav = document.getElementById('nav');
  const onScroll = () => {
    nav?.classList.toggle('nav-scrolled', window.scrollY > 50);
  };
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  const mobileBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const menuIcon = document.getElementById('menu-icon');

  const OPEN_PATH = 'M6 18L18 6M6 6h12v12z';
  const CLOSED_PATH = 'M4 6h16M4 12h16M4 18h16';

  const setMenu = (open: boolean) => {
    mobileMenu?.classList.toggle('hidden', !open);
    mobileBtn?.setAttribute('aria-expanded', String(open));
    if (menuIcon) {
      menuIcon.innerHTML = `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="${open ? OPEN_PATH : CLOSED_PATH}" />`;
    }
    document.body.style.overflow = open ? 'hidden' : '';
  };

  mobileBtn?.addEventListener('click', () => {
    setMenu(mobileMenu?.classList.contains('hidden') ?? true);
  });

  mobileMenu?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenu(false));
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && mobileMenu && !mobileMenu.classList.contains('hidden')) {
      setMenu(false);
      mobileBtn?.focus();
    }
  });
</script>
