---
import SEO from '../components/SEO.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import ExitIntent from '../components/ExitIntent.astro';
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  publishedTime?: string;
  jsonLd?: Record<string, unknown>[];
}

const siteData = await getCollection('site');
const { disclaimer } = siteData[0]?.data ?? { disclaimer: '' };
---

<!doctype html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add('js');</script>
    <SEO
      title={Astro.props.title}
      description={Astro.props.description}
      type={Astro.props.type}
      noindex={Astro.props.noindex}
      publishedTime={Astro.props.publishedTime}
      jsonLd={Astro.props.jsonLd}
    />
  </head>
  <body class="overflow-x-hidden pb-20 lg:pb-0">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-2xl focus:bg-white focus:px-5 focus:py-3 focus:text-sm focus:font-semibold focus:text-[#0a0a0f]"
    >
      Skip to content
    </a>
    <Nav />
    <main id="main">
      <slot />
    </main>
    <Footer disclaimer={disclaimer} />
    <StickyCta />
    <ExitIntent />
  </body>
  <script>
    // Progressive scroll-reveal: elements start visible if IntersectionObserver
    // is unavailable, and are always visible when reduced motion is requested.
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const targets = document.querySelectorAll<HTMLElement>('.reveal');

    if (!reduce && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
              observer.unobserve(entry.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      targets.forEach((el) => observer.observe(el));
    } else {
      targets.forEach((el) => el.classList.add('is-visible'));
    }
  </script>
</html>
